{
  "name": "used-housing-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "gate": "pnpm typecheck && pnpm lint && pnpm test",
    "seed:dev": "node --env-file=.env.local prisma/seed.dev.mjs",
    "db:up": "docker start renoel-dev-db",
    "db:down": "docker stop renoel-dev-db"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "fflate": "0.8.3",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
